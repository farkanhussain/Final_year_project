<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="3dp"
    app:cardCornerRadius="12dp"
    android:backgroundTint="@color/red_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- LEFT SIDE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/journalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Journal Title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/journalTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="12 Apr 2026"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="2dp"/>

            <!-- Mood -->
            <TextView
                android:id="@+id/journalMood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mood: 🙂"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/journalTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tags: CBT, Anxiety"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="6dp"/>
            <!-- Preview -->
            <TextView
                android:id="@+id/journalPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Journal entry preview goes here..."
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- RIGHT SIDE -->
        <ImageView
            android:id="@+id/journalOptionsIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_more_vert_24"
            app:tint="@color/white"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>