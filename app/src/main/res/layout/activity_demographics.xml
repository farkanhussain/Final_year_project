<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/demographicsToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/beige"
        android:title="Demographics"
        android:titleTextColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <ScrollView
        android:id="@+id/demographicsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/demographicsToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/demographicsRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">


        <!-- Title -->
        <TextView
            android:id="@+id/demographicsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Demographics (optional)"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/demographicsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/red_dark"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/demographicsTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/demographicsInnerLayout"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Full-time student -->
                <TextView
                    android:id="@+id/fullTimeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Full-time student?"
                    android:textColor="@color/white"
                    android:textSize="16sp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fullTimeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Select option"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/red_dark"
                    app:hintTextColor="@color/hint_colors"
                    app:boxStrokeColor="@color/white"
                    app:endIconMode="dropdown_menu">

                    <AutoCompleteTextView
                        android:id="@+id/fullTimeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/white"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- International student -->
                <TextView
                    android:id="@+id/internationalLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="International student?"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/internationalLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Select option"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/red_dark"
                    app:hintTextColor="@color/hint_colors"
                    app:boxStrokeColor="@color/white"
                    app:endIconMode="dropdown_menu">

                    <AutoCompleteTextView
                        android:id="@+id/internationalInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/white"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Race -->
                <TextView
                    android:id="@+id/raceLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Race (mark all that apply)"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp"/>

                <!-- South Asian -->
                <CheckBox
                    android:id="@+id/racePakistani"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pakistani"
                    android:textColor="@color/white"/>

                <CheckBox
                    android:id="@+id/raceIndian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Indian"
                    android:textColor="@color/white"/>

                <CheckBox
                    android:id="@+id/raceBangladeshi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bangladeshi"
                    android:textColor="@color/white"/>

                <CheckBox
                    android:id="@+id/raceSriLankan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sri Lankan"
                    android:textColor="@color/white"/>

                <CheckBox
                    android:id="@+id/raceNepali"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nepali"
                    android:textColor="@color/white"/>


                <!-- East Asian -->
                <CheckBox
                    android:id="@+id/raceChinese"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chinese"
                    android:textColor="@color/white"/>

                <!-- Black -->
                <CheckBox
                    android:id="@+id/raceBlack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Black"
                    android:textColor="@color/white"/>

                <!-- British -->
                <CheckBox
                    android:id="@+id/raceBritish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="British"
                    android:textColor="@color/white"/>

                <!-- Mixed -->
                <CheckBox
                    android:id="@+id/raceMixed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mixed ethnicity"
                    android:textColor="@color/white"/>

                <!-- Other -->
                <CheckBox
                    android:id="@+id/raceOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Other"
                    android:textColor="@color/white"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Continue Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveDemographicsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Finish"
            android:textColor="@color/white"
            android:backgroundTint="@color/green"
            app:rippleColor="@color/light_green"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="12dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/demographicsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

